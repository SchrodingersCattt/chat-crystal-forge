# Model configuration for natural-language chat; direct inspection needs no key.
# Copy to .env and fill values locally. Never commit real credentials.
# Process environment variables take precedence over this local configuration.

# Required when the selected endpoint requires authentication.
OPENAI_API_KEY=

# Use your provider's API root, including /v1 when required.
OPENAI_BASE_URL=https://api.openai.com/v1

# Exact model ID / SKU / deployment name accepted by that endpoint.
OPENAI_MODEL=